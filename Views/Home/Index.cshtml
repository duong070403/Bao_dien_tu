@model IEnumerable<WebBaoDienTu.Models.News>
@using System.Linq

@{
    ViewData["Title"] = ViewData["Title"] ?? "Tin hot nhất hôm nay";
    Layout = "_Layout";
    bool isHomePage = (ViewData["IsHomePage"]?.ToString() ?? "false") == "true";
}

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
<link href="~/css/home.css" rel="stylesheet">

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            @if (isHomePage)
            {
                <h1 class="fw-bold hot-title">Tin hot nhất hôm nay</h1>
            }
            else
            {
                <h1 class="fw-bold hot-title">@ViewData["Title"]</h1>
            }
        </div>
    </div>

    <!-- Row 1: 2 bài báo lớn -->
    <div class="row news-row">
        @foreach (var news in Model.ToList().Take(2))
        {
            <div class="col-md-6 col-lg-6 mb-4">
                <div class="card h-100">
                    <a href="@Url.Action("Read", "News", new { id = news.NewsId })">
                        <img src="@news.ImageUrl" class="card-img-top news-image large-news-image" alt="@news.Title">
                    </a>
                    <div class="card-body">
                        <h5 class="card-title">@news.Title</h5>
                        <p class="card-text">
                            @(string.IsNullOrEmpty(news.Content)
                                ? "Nội dung đang cập nhật..."
                                : (news.Content.Length > 150 ? news.Content.Substring(0, 150) + "..." : news.Content))
                            <a href="@Url.Action("Read", "News", new { id = news.NewsId })" class="read-more">Xem thêm</a>
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Từ Row 2 trở đi: Mỗi row 3 bài báo -->
    @{
        var remainingNews = Model.ToList().Skip(2).ToList();
        int itemsPerRow = 3;
        int rowCount = (int)Math.Ceiling((double)remainingNews.Count / itemsPerRow);

        for (int i = 0; i < rowCount; i++)
        {
            var newsInRow = remainingNews.Skip(i * itemsPerRow).Take(itemsPerRow);
            <div class="row news-row">
                @foreach (var news in newsInRow)
                {
                    <div class="col-md-5 col-lg-3 mb-4">
                        <div class="card h-100">
                            <a href="@Url.Action("Read", "News", new { id = news.NewsId })">
                                <img src="@news.ImageUrl" class="card-img-top news-image" alt="@news.Title">
                            </a>
                            <div class="card-body">
                                <h5 class="card-title">@news.Title</h5>
                                <p class="card-text">
                                    @(string.IsNullOrEmpty(news.Content)
                                    ? "Nội dung đang cập nhật..."
                                    : (news.Content.Length > 100 ? news.Content.Substring(0, 100) + "..." : news.Content))
                                    <a href="@Url.Action("Read", "News", new { id = news.NewsId })" class="read-more">Xem thêm</a>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>